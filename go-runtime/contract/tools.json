  {
    "name": "meiju_control",
    "description": "Change only requested fields on an account-owned AC; at least one setting is required.\n\n        Power is an explicit boolean. Mode/fan/temperature never implicitly turn power on.\n        Temperature uses the candidate 17–30°C / 0.5°C client policy. Checks membership and\n        fresh state before one write, then independently reads back. Never auto-retry an\n        uncertain outcome. A matching cloud readback does not prove physical execution.\n        ",
    "inputSchema": {
      "properties": {
        "device_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "power": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Power"
        },
        "target_temperature": {
          "anyOf": [
            {
              "maximum": 30,
              "minimum": 17,
              "multipleOf": 0.5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Temperature"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "cool",
                "heat",
                "dry",
                "fan"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "fan_speed": {
          "anyOf": [
            {
              "enum": [
                "silent",
                "low",
                "medium",
                "high",
                "full",
                "auto"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fan Speed"
        }
      },
      "required": [
        "device_id"
      ],
      "title": "meiju_controlArguments",
      "type": "object",
      "additionalProperties": false
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "meiju_controlDictOutput",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  }
]